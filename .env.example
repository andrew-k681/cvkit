# Copy to .env and fill in. .env is gitignored and is never sourced by cvkit --
# the tools read one variable at a time out of it, so a stray line in this file
# can never be executed.

# Roboflow private API key: https://app.roboflow.com -> Settings -> API Keys
ROBOFLOW_API_KEY=

# Default Roboflow target, so you do not repeat --workspace/--project.
# Both are the URL slugs, e.g. app.roboflow.com/<workspace>/<project>
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=

# Optional: project root cvkit resolves data/ and runs/ against.
# Defaults to the current working directory.
# CVKIT_ROOT=
